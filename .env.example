# ---------------------------------------------------------------------------
# Nexora CPQ — environment template
# Copy to .env and fill in. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the application at runtime.
# Neon: copy the "Pooled connection" string from your project dashboard.
DATABASE_URL="postgresql://user:password@host/nexora_cpq?sslmode=require"

# Direct (non-pooled) connection used by Prisma Migrate only.
# Neon: the "Direct connection" string. Migrations cannot run over a pooler.
DIRECT_DATABASE_URL="postgresql://user:password@host/nexora_cpq?sslmode=require"

# --- Authentication (Better Auth) ------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public origin users browse. Locally that is the microfrontends proxy
# (`pnpm dev` starts it on 3024), which serves both zones from one origin.
BETTER_AUTH_URL="http://localhost:3024"

# --- Micro frontend origins ------------------------------------------------
# PLATFORM_URL is the public origin (used for absolute links in emails);
# CPQ_URL is the CPQ deployment itself, used for its availability check.
NEXT_PUBLIC_PLATFORM_URL="http://localhost:3024"
NEXT_PUBLIC_CPQ_URL="http://localhost:3001"

# --- Email -----------------------------------------------------------------
# "console"  — logs rendered emails to stdout (default, no credentials needed)
# "filesystem" — writes .html files to .mail/ for inspection
# "resend"   — real delivery; requires RESEND_API_KEY
EMAIL_PROVIDER="console"
EMAIL_FROM="quotes@nexora-telecom.demo"
# RESEND_API_KEY=""

# --- Observability ---------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL="info"

# --- Demo mode -------------------------------------------------------------
# Shows the demo credential picker on the sign-in screen.
NEXT_PUBLIC_DEMO_MODE="true"

# Comma-separated origins allowed to call the auth endpoints.
# In a micro frontend the browser is served from the PROXY origin, not from the
# Platform app directly, so that origin must be trusted or every auth mutation
# returns 403. Locally the dev proxy (http://localhost:3024) is trusted
# automatically; set this in production to your real domains.
AUTH_TRUSTED_ORIGINS=""
