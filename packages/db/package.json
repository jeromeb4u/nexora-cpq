{
  "name": "@nexora/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@nexora/types": "workspace:*",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@nexora/config": "workspace:*",
    "@nexora/cpq-engine": "workspace:*",
    "better-auth": "1.7.5",
    "eslint": "^9.39.1",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
