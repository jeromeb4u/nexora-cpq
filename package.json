{
  "name": "nexora-cpq",
  "private": true,
  "version": "0.1.0",
  "description": "Nexora Telecom — Enterprise Configure-Price-Quote platform (two-MFE monorepo)",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev proxy --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "playwright test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @nexora/db generate",
    "db:migrate": "pnpm --filter @nexora/db migrate",
    "db:push": "pnpm --filter @nexora/db push",
    "db:seed": "pnpm --filter @nexora/db seed",
    "db:reset": "pnpm --filter @nexora/db reset",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "db:studio": "pnpm --filter @nexora/db studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  }
}
